# Connexion PostgreSQL (production — ex. Neon). Laissez vide en local :
# une base SQLite est automatiquement créée dans .data/local.db pour le développement.
DATABASE_URL=

# Mot de passe du panneau d'administration (/admin). Obligatoire pour que /admin fonctionne.
# Choisissez une valeur longue et aléatoire — c'est le seul secret protégeant l'édition du contenu.
ADMIN_PASSWORD=
